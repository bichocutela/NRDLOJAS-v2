rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Compatibilidade imediata com as contas administrativas atuais e
    // preparação para migrar o papel para custom claims sem nova troca de regras.
    function isManager() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'mestre' ||
        request.auth.token.email == 'admin@nrdlojas.com' ||
        request.auth.token.email == 'mestre@nrdlojas.com'
      );
    }

    function isMaster() {
      return isSignedIn() && request.auth.token.email == 'mestre@nrdlojas.com';
    }
    function publicRestrictedAccess() {
      return exists(/databases/$(database)/documents/config/restricted_access) &&
        get(/databases/$(database)/documents/config/restricted_access).data.publicAccess == true;
    }
    function canReadProfile() {
      return publicRestrictedAccess() || isMaster() || (isSignedIn() &&
        exists(/databases/$(database)/documents/restricted_access/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/restricted_access/$(request.auth.uid)).data.enabled == true &&
        get(/databases/$(database)/documents/restricted_access/$(request.auth.uid)).data.profile == true);
    }
    match /restricted_access/{uid} {
      allow get: if isMaster() || (isSignedIn() && request.auth.uid == uid);
      allow list, delete: if isMaster();
      allow create, update: if isMaster() &&
        request.resource.data.keys().hasOnly(['login', 'enabled', 'profile', 'promotions', 'prices']) &&
        request.resource.data.login is string && request.resource.data.login.size() <= 64 &&
        request.resource.data.enabled is bool && request.resource.data.profile is bool &&
        request.resource.data.promotions is bool && request.resource.data.prices is bool;
    }

    // Catálogo público para consulta. Criação, remoção e alterações de conteúdo
    // ficam restritas a Admin/Mestre. O único update público permitido é o
    // incremento unitário do contador global de visualização.
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isManager();
      allow update: if isManager() || (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['searchCount', 'lastViewedAt']) &&
        request.resource.data.searchCount is int &&
        resource.data.searchCount is int &&
        request.resource.data.searchCount == resource.data.searchCount + 1 &&
        request.resource.data.lastViewedAt == request.time
      );
    }

    // Configurações globais precisam ser lidas por todos os aparelhos, mas só
    // podem ser publicadas por perfis administrativos autenticados.
    match /config/{document} {
      allow read: if true;
      allow write: if document != 'restricted_access' && isManager();
      allow create, update: if document == 'restricted_access' && isMaster() &&
        request.resource.data.keys().hasOnly(['publicAccess']) && request.resource.data.publicAccess is bool;
      allow delete: if document == 'restricted_access' && isMaster();
    }

    // Histórico de novidades publicado pelo Painel Mestre.
    match /app_novelties/{noveltyId} {
      allow read: if true;
      allow create, update, delete: if isManager();
    }

    // Escalas publicadas para leitura pelos colaboradores; apenas Mestre/Admin altera.
    match /work_schedules/{monthKey} {
      allow read: if canReadProfile();
      allow create, update: if isManager() &&
        request.resource.data.year is int &&
        request.resource.data.month is int && request.resource.data.month >= 1 && request.resource.data.month <= 12 &&
        request.resource.data.employees is list && request.resource.data.employees.size() <= 200;
      allow delete: if isManager();
    }

    // Abas dinâmicas fazem parte da navegação pública do aplicativo.
    match /dynamic_tabs/{tabId} {
      allow read: if true;
      allow write: if isManager();
    }

    // Documento legado/auxiliar observado pelos clientes.
    match /latest_product/{document} {
      allow read: if true;
      allow write: if isManager();
    }

    // Histórico e snapshots do catálogo são exclusivamente administrativos.
    match /catalog_history/{snapshotId} {
      allow read, write: if isManager();

      match /products/{snapshotProductId} {
        allow read, write: if isManager();
      }
    }

    // Sugestões podem ser enviadas por usuários do aplicativo sem login, mas a
    // criação é estritamente limitada aos campos e ao estado inicial esperados.
    // Alterações de status são administrativas. Exclusão pelo próprio usuário só
    // é aceita quando há Firebase Auth real e o UID do documento pertence a ele;
    // sugestões anônimas antigas continuam removíveis por Admin/Mestre.
    match /suggestions/{suggestionId} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly([
          'text',
          'submittedBy',
          'submittedByUid',
          'installationId',
          'appVersion',
          'createdAt',
          'status'
        ]) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 1000 &&
        request.resource.data.submittedBy is string &&
        request.resource.data.submittedBy.size() <= 200 &&
        request.resource.data.submittedByUid is string &&
        request.resource.data.submittedByUid.size() <= 200 &&
        request.resource.data.installationId is string &&
        request.resource.data.installationId.size() > 0 &&
        request.resource.data.installationId.size() <= 200 &&
        request.resource.data.appVersion is string &&
        request.resource.data.appVersion.size() <= 64 &&
        request.resource.data.createdAt is int &&
        request.resource.data.status == 'pending';

      allow update: if isManager();

      allow delete: if isManager() || (
        isSignedIn() &&
        resource.data.status == 'fixed' &&
        resource.data.submittedByUid == request.auth.uid
      );
    }

    // Um documento por aparelho. O Android envia somente um SHA-256 derivado
    // do ANDROID_ID; o identificador bruto nunca é salvo na nuvem.
    match /app_installations/{deviceId} {
      // Necessário para a transação descobrir se este aparelho já foi registrado.
      // Não permite enumerar a coleção.
      allow get: if true;
      allow list: if isManager();

      allow create: if
        request.resource.data.keys().hasOnly([
          'deviceIdHash',
          'firstSeenAt',
          'lastSeenAt',
          'appVersion',
          'appVersionCode',
          'platform'
        ]) &&
        request.resource.data.deviceIdHash == deviceId &&
        request.resource.data.deviceIdHash is string &&
        request.resource.data.deviceIdHash.size() == 64 &&
        request.resource.data.firstSeenAt == request.time &&
        request.resource.data.lastSeenAt == request.time &&
        request.resource.data.appVersion is string &&
        request.resource.data.appVersion.size() <= 64 &&
        request.resource.data.appVersionCode is int &&
        request.resource.data.platform == 'android';

      allow update: if
        request.resource.data.deviceIdHash == resource.data.deviceIdHash &&
        request.resource.data.firstSeenAt == resource.data.firstSeenAt &&
        request.resource.data.platform == resource.data.platform &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastSeenAt', 'appVersion', 'appVersionCode']) &&
        request.resource.data.lastSeenAt == request.time &&
        request.resource.data.appVersion is string &&
        request.resource.data.appVersion.size() <= 64 &&
        request.resource.data.appVersionCode is int;

      allow delete: if isManager();
    }

    // Qualquer coleção não declarada acima permanece bloqueada por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
